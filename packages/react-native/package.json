{
  "name": "@pletopay/react-native",
  "version": "1.0.0",
  "description": "Pletopay checkout for React Native and Expo: the hosted bank-transfer checkout in a WebView with completion detection, plus a headless client for the checkout session API.",
  "license": "MIT",
  "author": "Pletopay",
  "homepage": "https://docs.pletopay.com/checkout/hosted",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pletopay/pletopay-sdk-web.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/pletopay/pletopay-sdk-web/issues"
  },
  "keywords": [
    "pletopay",
    "react-native",
    "expo",
    "checkout",
    "payments",
    "nigeria",
    "bank transfer",
    "webview"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "check:package": "pnpm build && publint && attw --pack . --profile node16"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-webview": ">=13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-native-webview": "^14.0.1",
    "test-renderer": "^1.0.0"
  }
}
