{
  "name": "@pletopay/vue",
  "version": "1.0.0",
  "description": "Pletopay checkout for Vue 3: a plugin, composables and a button that open the bank-transfer checkout popup with your publishable key.",
  "license": "MIT",
  "author": "Pletopay",
  "homepage": "https://docs.pletopay.com/checkout/popup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pletopay/pletopay-sdk-web.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/pletopay/pletopay-sdk-web/issues"
  },
  "keywords": [
    "pletopay",
    "vue",
    "checkout",
    "payments",
    "nigeria",
    "bank transfer"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:package": "pnpm build && publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@pletopay/js": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "vue": "^3.5.44"
  }
}
