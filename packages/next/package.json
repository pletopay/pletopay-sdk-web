{
  "name": "@pletopay/next",
  "version": "1.0.0",
  "description": "Pletopay for Next.js: the React checkout components plus server helpers (App Router and Pages Router webhook handlers, a server client over @pletopay/node).",
  "license": "MIT",
  "author": "Pletopay",
  "homepage": "https://docs.pletopay.com/checkout/popup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidenze/pletopay-sdk-web.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/evidenze/pletopay-sdk-web/issues"
  },
  "keywords": [
    "pletopay",
    "next",
    "nextjs",
    "react",
    "checkout",
    "webhooks",
    "payments",
    "nigeria"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:package": "pnpm build && publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@pletopay/node": "^1.0.0",
    "@pletopay/react": "workspace:^"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  }
}
